generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  profesor
  estudiante
}

enum SchedulingRuleType {
  boolean
  number
  string
  json
}

enum WeekDay {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo
}

enum ClassroomType {
  aula
  laboratorio
  auditorio
  sala_computo
  otro
}

enum UserStatus {
  active
  suspended
  blocked
}

enum StudentStatus {
  activo
  egresado
  retirado
  suspendido
}

enum EnrollmentStatus {
  inscrito
  retirado
  aprobado
  reprobado
}

model User {
  id                  String               @id @default(cuid())
  nombre              String
  apellido            String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  rol                 Role                 @default(estudiante)
  activo              Boolean              @default(true)
  verificado          Boolean              @default(false)
  status              UserStatus           @default(active)
  blockedUntil        DateTime?            @map("blocked_until")
  blockReason         String?              @map("block_reason")
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  student             Student?

  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?   @map("user_id")
  action     String
  details    Json?
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model TimeSlotGroup {
  id         String      @id @default(cuid())
  nombre     String      @unique
  horaInicio String      @map("hora_inicio")
  horaFin    String      @map("hora_fin")
  activo     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  timeBlocks TimeBlock[]

  @@map("time_slot_groups")
}

model TimeBlock {
  id              String        @id @default(cuid())
  grupoId         String        @map("grupo_id")
  nombre          String
  horaInicio      String        @map("hora_inicio")
  horaFin         String        @map("hora_fin")
  duracionMinutos Int           @map("duracion_minutos")
  orden           Int
  activo          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  grupo           TimeSlotGroup @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  scheduleMeetings SectionScheduleMeeting[]

  @@unique([grupoId, orden])
  @@index([grupoId])
  @@map("time_blocks")
}

model SchedulingRule {
  id          String             @id @default(cuid())
  clave       String             @unique
  valor       String
  tipo        SchedulingRuleType
  descripcion String?
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("scheduling_rules")
}

model AcademicConfig {
  id                       String   @id @default(cuid())
  nombre                   String   @default("Configuracion general")
  sesionesPorSemanaDefault Int      @default(3) @map("sesiones_por_semana_default")
  duracionSesionDefault    Int      @default(90) @map("duracion_sesion_default")
  diasHabiles              Json     @map("dias_habiles")
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("academic_config")
}

model Teacher {
  id               String                   @id @default(cuid())
  nombre           String
  apellido         String
  email            String                   @unique
  departamento     String
  titulo           String?
  maxHorasSemana   Int                      @default(20) @map("max_horas_semana")
  activo           Boolean                  @default(true)
  deletedAt        DateTime?                @map("deleted_at")
  deletedBy        String?                  @map("deleted_by")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  availabilities   TeacherAvailability[]
  assignableCourses TeacherAssignableCourse[]
  sections         CourseSection[]

  @@index([deletedAt])
  @@map("teachers")
}

model TeacherAvailability {
  id         String   @id @default(cuid())
  teacherId  String   @map("teacher_id")
  diaSemana  WeekDay  @map("dia_semana")
  horaInicio String   @map("hora_inicio")
  horaFin    String   @map("hora_fin")
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, diaSemana])
  @@map("teacher_availabilities")
}

model TeacherAssignableCourse {
  id          String   @id @default(cuid())
  teacherId   String   @map("teacher_id")
  codigoCurso String?  @map("codigo_curso")
  nombreCurso String   @map("nombre_curso")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_assignable_courses")
}

model Course {
  id                  String          @id @default(cuid())
  codigo              String          @unique
  nombre              String
  departamento        String
  creditos            Int
  sesionesPorSemana   Int             @map("sesiones_por_semana")
  duracionMinutos     Int             @map("duracion_minutos")
  activo              Boolean         @default(true)
  deletedAt           DateTime?       @map("deleted_at")
  deletedBy           String?         @map("deleted_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  sections            CourseSection[]

  @@index([deletedAt])
  @@map("courses")
}

model CourseSection {
  id              String     @id @default(cuid())
  courseId        String     @map("course_id")
  codigoSeccion   String     @map("codigo_seccion")
  teacherId       String?    @map("teacher_id")
  classroomId     String?    @map("classroom_id")
  periodoId       String?    @map("periodo_id")
  capacidad       Int
  inscritos       Int        @default(0)
  horarioResumen  String?    @map("horario_resumen")
  activo          Boolean    @default(true)
  deletedAt       DateTime?  @map("deleted_at")
  deletedBy       String?    @map("deleted_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  classroom       Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  periodo         AcademicPeriod? @relation(fields: [periodoId], references: [id], onDelete: SetNull)
  scheduleMeetings SectionScheduleMeeting[]
  enrollments     Enrollment[]

  @@unique([courseId, codigoSeccion])
  @@index([courseId])
  @@index([teacherId])
  @@index([classroomId])
  @@index([periodoId])
  @@index([deletedAt])
  @@map("course_sections")
}

model Classroom {
  id             String          @id @default(cuid())
  codigo         String          @unique
  edificio       String
  piso           String?
  tipo           ClassroomType
  capacidad      Int
  equipamiento   Json
  activo         Boolean         @default(true)
  deletedAt      DateTime?       @map("deleted_at")
  deletedBy      String?         @map("deleted_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  sections       CourseSection[]
  availabilities ClassroomAvailability[]
  scheduleMeetings SectionScheduleMeeting[]

  @@index([deletedAt])
  @@map("classrooms")
}

model ClassroomAvailability {
  id          String    @id @default(cuid())
  classroomId String    @map("classroom_id")
  diaSemana   WeekDay   @map("dia_semana")
  horaInicio  String    @map("hora_inicio")
  horaFin     String    @map("hora_fin")
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, diaSemana])
  @@map("classroom_availabilities")
}

model SectionScheduleMeeting {
  id          String        @id @default(cuid())
  sectionId   String        @map("section_id")
  diaSemana   WeekDay       @map("dia_semana")
  timeBlockId String        @map("time_block_id")
  classroomId String        @map("classroom_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timeBlock   TimeBlock     @relation(fields: [timeBlockId], references: [id], onDelete: Restrict)
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@unique([sectionId, diaSemana, timeBlockId])
  @@unique([classroomId, diaSemana, timeBlockId])
  @@index([sectionId])
  @@index([timeBlockId])
  @@index([classroomId])
  @@map("section_schedule_meetings")
}

model AcademicPeriod {
  id          String          @id @default(cuid())
  codigo      String          @unique
  nombre      String
  fechaInicio DateTime        @map("fecha_inicio")
  fechaFin    DateTime        @map("fecha_fin")
  esActual    Boolean         @default(false) @map("es_actual")
  activo      Boolean         @default(true)
  deletedAt   DateTime?       @map("deleted_at")
  deletedBy   String?         @map("deleted_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  sections    CourseSection[]
  enrollments Enrollment[]

  @@index([deletedAt])
  @@index([esActual])
  @@map("academic_periods")
}

model Program {
  id           String    @id @default(cuid())
  codigo       String    @unique
  nombre       String
  departamento String
  activo       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  students     Student[]

  @@index([deletedAt])
  @@map("programs")
}

model Student {
  id          String        @id @default(cuid())
  codigo      String        @unique
  nombre      String
  apellido    String
  email       String        @unique
  userId      String?       @unique @map("user_id")
  programId   String?       @map("program_id")
  estado      StudentStatus @default(activo)
  deletedAt   DateTime?     @map("deleted_at")
  deletedBy   String?       @map("deleted_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  program     Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@index([deletedAt])
  @@index([programId])
  @@map("students")
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String           @map("student_id")
  sectionId String           @map("section_id")
  periodoId String           @map("periodo_id")
  estado    EnrollmentStatus @default(inscrito)
  deletedAt DateTime?        @map("deleted_at")
  deletedBy String?          @map("deleted_by")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section   CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  periodo   AcademicPeriod   @relation(fields: [periodoId], references: [id], onDelete: Restrict)

  @@unique([studentId, sectionId, periodoId])
  @@index([sectionId])
  @@index([studentId])
  @@index([periodoId])
  @@index([deletedAt])
  @@map("enrollments")
}
