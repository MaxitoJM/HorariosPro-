# =============================================================================
# DESARROLLO LOCAL
# Copia este archivo como `.env` y ajusta valores.
# =============================================================================
NODE_ENV=development
PORT=4000

# Postgres local (Docker). Cambia USER/PASSWORD si difieren de tu setup.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/proyecto_nucleo?schema=public"

# Genera un secreto fuerte para local también:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_a_secure_random_secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_EXPIRES_MINUTES=15
BCRYPT_ROUNDS=12

# Orígenes permitidos (coma-separados). Incluye los puertos de tu frontend local.
CORS_ORIGIN="http://localhost:5500,http://localhost:5173"

# Cookies: en HTTP local Secure=false y SameSite=lax es correcto.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# PRODUCCIÓN (Render / Railway / Fly.io, etc.)
# NO copies estos valores tal cual. Configúralos en el panel del hosting.
# =============================================================================
# NODE_ENV=production
# PORT=4000                                  # Render/Railway suelen inyectar PORT automáticamente
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"   # Neon/Supabase requieren sslmode=require
# JWT_ACCESS_SECRET="<openssl rand -hex 32>"  # OBLIGATORIO: el server falla si queda el default
# CORS_ORIGIN="https://tu-app.vercel.app"     # exacto, sin barra final, sin wildcards
# COOKIE_SECURE=true                          # OBLIGATORIO con HTTPS
# COOKIE_SAMESITE=none                        # OBLIGATORIO si frontend (Vercel) y backend están en dominios distintos
